ASKU_HTTP_ADDR=:18080
ASKU_DATABASE_URL=postgres://asku:asku_dev@localhost:55432/asku?sslmode=disable
ASKU_REDIS_ADDR=localhost:6385
ASKU_REDIS_PASSWORD=
ASKU_SCHOOL_CONFIG=../config/schools/whut.yaml
ASKU_DEV_AUTH_ENABLED=true
ASKU_AGENT_MODE=policy
ASKU_LLM_PROVIDER=mock
ASKU_LLM_BASE_URL=
ASKU_LLM_API_KEY=
ASKU_LLM_MODEL=asku-mock
ASKU_LLM_TIMEOUT=45s
# 供应商每百万 Token 的人民币单价；请按实际合同填写。
ASKU_LLM_INPUT_RMB_PER_MTOK=0
ASKU_LLM_OUTPUT_RMB_PER_MTOK=0
ASKU_WEB_SEARCH_PROVIDER=mock
ASKU_WEB_SEARCH_BASE_URL=
ASKU_WEB_SEARCH_API_KEY=
ASKU_WEB_SEARCH_TIMEOUT=12s
ASKU_WEB_SEARCH_TOP_N=3
ASKU_WEB_SEARCH_SEARCH_TTL=10m
ASKU_WEB_SEARCH_PAGE_TTL=30m
ASKU_WEB_SEARCH_EXTRACT_TTL=30m
ASKU_KNOWLEDGE_PROVIDER=disabled
# 启用 weknora 时填写服务地址、Scoped API Key，并在学校 YAML 中填写 official_knowledge_base_id。
ASKU_WEKNORA_BASE_URL=
ASKU_WEKNORA_API_KEY=
ASKU_WEKNORA_TIMEOUT=12s
ASKU_KNOWLEDGE_TOP_N=4
ASKU_KNOWLEDGE_QUERY_CACHE_TTL=10m
ASKU_ANSWER_CACHE_TTL=30m
ASKU_QUESTION_RATE_LIMIT_PER_MINUTE=30
ASKU_ACCESS_TOKEN_TTL=1h
ASKU_REFRESH_TOKEN_TTL=720h
ASKU_SHUTDOWN_TIMEOUT=10s
ASKU_CORS_ORIGINS=*
# 留空时 Admin API 返回 404；生产环境必须使用独立高熵密钥。
ASKU_ADMIN_TOKEN=
ASKU_REPORTING_TIMEZONE=Asia/Shanghai

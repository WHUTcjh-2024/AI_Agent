{
  "name": "mobile",
  "version": "0.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "expo": "~57.0.19",
    "expo-clipboard": "~57.0.1",
    "expo-crypto": "~57.0.2",
    "expo-font": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "19.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "react-test-renderer": "19.2.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/features/timetable src/app/navigation/RootNavigator.tsx src/app/providers/AppProviders.tsx src/screens/Home/HomeScreen.tsx src/types/navigation.ts tests scripts/build-timetable-browser.mjs --max-warnings 0",
    "lint:all": "eslint src App.tsx index.ts --max-warnings 0",
    "test": "node scripts/build-timetable-browser.mjs --check && tsx --test tests/*.test.ts",
    "timetable:bundle": "node scripts/build-timetable-browser.mjs",
    "doctor": "npx expo-doctor",
    "export:android": "expo export --platform android --output-dir dist/android-bundle",
    "export:ios": "expo export --platform ios --output-dir dist/ios-bundle"
  },
  "private": true
}
